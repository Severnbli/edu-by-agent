#!/usr/bin/env bash
# Run the edu CLI in Docker. Usage: ./edu <command> [args]  (./edu --help)
# Extra: ./edu proxy up|down|logs   ./edu test [pytest args]   ./edu lint   ./edu build
set -euo pipefail
cd "$(dirname "$0")"

export UID
GID="$(id -g)"
export GID
mkdir -p .session

# Proxy service for the configured mode: direct (EDU_INTERFACE) wins over Shadowsocks.
env_set() { [[ -n "${!1:-}" ]] || grep -qE "^$1=.+" .env 2>/dev/null; }
if env_set EDU_PROXY; then proxy_svc=""
elif env_set EDU_INTERFACE; then proxy_svc=direct
elif env_set EDU_SS_URL || env_set EDU_SS_CONFIG; then proxy_svc=ss
else proxy_svc=""; fi

case "${1:-} ${2:-}" in
  "proxy up")
    [[ -n "$proxy_svc" ]] || { echo "Nothing to start: EDU_PROXY is used as is, or no proxy is configured." >&2; exit 1; }
    docker compose stop direct ss >/dev/null 2>&1 || true
    exec docker compose up -d "$proxy_svc" ;;
  "proxy down") exec docker compose stop direct ss ;;
  "proxy logs") exec docker compose logs -f direct ss ;;
esac

case "${1:-}" in
  build) exec docker compose build ;;
  test) shift; exec docker compose run --rm -T --entrypoint pytest edu "$@" ;;
  lint) exec docker compose run --rm -T --entrypoint sh edu -c "ruff check . && ruff format --check ." ;;
  fmt) exec docker compose run --rm -T --entrypoint sh edu -c "ruff check --fix . && ruff format ." ;;
esac

# The desktop browser needs the host X server; allow only this user (matched by UID).
if [[ "${1:-}" == "browse" || "${1:-} ${2:-}" == "session login" ]]; then
  xhost "+SI:localuser:$(id -un)" >/dev/null 2>&1 || echo "warning: xhost failed, the browser window may not open" >&2
fi

tty_flag=()
[[ -t 0 ]] || tty_flag=(-T)
exec docker compose run --rm "${tty_flag[@]}" edu "$@"
