# Copy to .env and fill in. .env is git-ignored.

# Site URLs (defaults: Brest region instance)
EDU_LOGIN_URL=https://wp.brest-region.edu.by/
EDU_CONSTRUCTOR_URL=https://wp.brest-region.edu.by/explorer.aspx

# Proxy: either a direct proxy URL ...
# EDU_PROXY=socks5h://user:pass@host:1080
# ... or Shadowsocks via a local sslocal (run `edu proxy up`):
# EDU_SS_URL=ss://...
# EDU_SS_CONFIG=/path/to/shadowsocks.json
# EDU_SS_LOCAL_PORT=1080
# EDU_SS_BIN=sslocal

# Session
# EDU_SESSION_DIR=.session
# EDU_KEEPALIVE_MINUTES=45
