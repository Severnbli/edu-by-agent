# Copy to .env and fill in. .env is git-ignored.

# Site URLs (defaults: Brest region instance)
EDU_LOGIN_URL=https://wp.brest-region.edu.by/
EDU_CONSTRUCTOR_URL=https://wp.brest-region.edu.by/explorer.aspx

# Proxy – pick one (priority: EDU_PROXY > EDU_INTERFACE > Shadowsocks).
# Direct mode: go out via this interface, bypassing a VPN default route (run `./edu proxy up`):
# EDU_INTERFACE=wlo1
# EDU_DIRECT_PORT=1081
# A proxy URL ...
# EDU_PROXY=socks5h://user:pass@host:1080
# ... or Shadowsocks via the ss container (run `./edu proxy up`):
# EDU_SS_URL=ss://...
# EDU_SS_CONFIG=secrets/shadowsocks.json   # path inside the repo (git-ignored dir)
# EDU_SS_LOCAL_PORT=1080

# Session
# EDU_SESSION_DIR=.session
# EDU_KEEPALIVE_MINUTES=45
